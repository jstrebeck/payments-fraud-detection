# Copy to .env for tools run on the host (make api, the Phase 2 trainer).
# Never commit .env. Values match the docker-compose stack; they are
# throwaway local-dev credentials.

# payments-api
DATABASE_URL=postgresql+asyncpg://fraud:fraud@localhost:5432/payments
FRAUD_SCORER=mlflow          # rule | mlflow | kserve (Phase 4)
REVIEW_THRESHOLD=0.5
DECLINE_THRESHOLD=0.8
MODEL_REFRESH_SECONDS=60
REQUIRE_SCORER=false
LOG_LEVEL=INFO
LOG_FORMAT=console           # console | json
KSERVE_URL=http://localhost:8080/v2/models/fraud-detector/infer
MODEL_NAME=fraud-detector
MODEL_ALIAS=champion

# simulator
SIMULATOR_API_URL=http://localhost:8000

# MLflow: the homelab server (ADR-0012). It proxies artifacts, so clients
# need no S3 credentials.
MLFLOW_TRACKING_URI=http://192.168.2.202
MLFLOW_EXPERIMENT_NAME=fraud-detector-dev

# Without the homelab: `make dev-mlflow`, then use these instead.
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_S3_ENDPOINT_URL=http://localhost:8333
# AWS_ACCESS_KEY_ID=fraud
# AWS_SECRET_ACCESS_KEY=fraud-local-only
